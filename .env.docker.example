# Copiar como .env.docker y cambiar todos los secretos antes de publicar.
CADDYFILE_PATH=./Caddyfile
HTTP_PORT=80
HTTPS_PORT=443
DB_NAME=onlyfood
DB_USER=onlyfood
DB_PASSWORD=reemplazar_con_password_seguro
DB_ROOT_PASSWORD=reemplazar_con_otro_password_seguro
SUPERADMIN_EMAIL=admin@tu-dominio.com
SUPERADMIN_PASSWORD=reemplazar_con_password_superadmin_seguro
AUTH_SALT=reemplazar_con_una_cadena_aleatoria_larga
ENCRYPTION_MASTER_KEY=reemplazar_con_clave_aes256_maestra
# Base64 de 32 bytes; debe mantenerse estable entre builds.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=reemplazar_con_base64_de_32_bytes
BASE_DOMAIN=nanoapps.ar
BASE_URL=https://onlyfood.nanoapps.ar
R2_PUBLIC_URL=https://cdn.nanoapps.ar
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=onlyfood
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_PROVIDER=r2
ALLOW_LOCAL_STORAGE=false
SEED_DEMO_DATA=false
# Opcional: credenciales globales de integraciones
PLATFORM_MP_ACCESS_TOKEN=
PLATFORM_MP_WEBHOOK_SECRET=
MP_WEBHOOK_SECRET=
META_APP_SECRET=reemplazar_con_el_secreto_de_la_app_de_meta
META_GRAPH_API_VERSION=v23.0
PRINTNODE_API_KEY=
VAPID_SUBJECT=mailto:soporte@nanoapps.ar
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TZ=America/Argentina/Buenos_Aires
BUSINESS_TIME_ZONE=America/Argentina/Buenos_Aires
# SMTP de referencia (OnlyPadel). En los correos de seguridad, configurar cada tenant desde Admin > Correo.
# Completar SMTP_PASS de forma segura; no incluir contraseñas reales en Git.
# No hay fallback global de correo para recuperación: usuario, contraseña y remitente son del tenant.
EMAIL_PROVIDER=SMTP
SMTP_HOST=c2801249.ferozo.com
SMTP_PORT=465
SMTP_USER=psp@nanolabs.online
SMTP_PASS=
SMTP_FROM="OnlyFood <psp@nanolabs.online>"
# Alternativamente EMAIL_PROVIDER=RESEND / BREVO:
EMAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=
