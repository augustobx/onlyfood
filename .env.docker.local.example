# Desarrollo local únicamente. Copiar como .env.docker y reemplazar las claves.
CADDYFILE_PATH=./Caddyfile.local
HTTP_PORT=8080
HTTPS_PORT=8443
DB_NAME=onlyfood
DB_USER=onlyfood
DB_PASSWORD=local_onlyfood_change_me
DB_ROOT_PASSWORD=local_root_change_me
SUPERADMIN_EMAIL=admin@localhost.test
SUPERADMIN_PASSWORD=LocalAdminPass2026!
DEMO_ADMIN_PASSWORD=LocalDemoPass2026!
AUTH_SALT=change_me_with_at_least_32_random_characters_local
ENCRYPTION_MASTER_KEY=change_me_with_at_least_32_random_characters_aes
BASE_DOMAIN=localhost
BASE_URL=http://localhost:8080
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE=true
SEED_DEMO_DATA=true
MP_WEBHOOK_SECRET=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
PRINTNODE_API_KEY=
VAPID_SUBJECT=mailto:dev@localhost.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TZ=America/Argentina/Buenos_Aires
# SMTP de referencia (OnlyPadel). En los correos de seguridad, configurar cada tenant desde Admin > Correo.
# Completar SMTP_PASS de forma segura; no incluir contraseñas reales en Git.
# No hay fallback global de correo para recuperación: usuario, contraseña y remitente son del tenant.
EMAIL_PROVIDER=SMTP
SMTP_HOST=c2801249.ferozo.com
SMTP_PORT=465
SMTP_USER=psp@nanolabs.online
SMTP_PASS=
SMTP_FROM="OnlyFood <psp@nanolabs.online>"
# Alternativamente EMAIL_PROVIDER=RESEND / BREVO:
EMAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=
